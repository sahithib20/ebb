{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/ebb/schemas/source-report.v1.schema.json",
  "title": "Ebb source check report v1",
  "description": "Validation and freshness report generated by tools/check-sources.ts for all registered rule sources.",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkedAt",
    "registries",
    "rules",
    "sources",
    "ok",
    "stale",
    "duePromotion",
    "unreachable",
    "changed",
    "blocked",
    "unrecorded"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "ebb.source-check.v1" },
    "checkedAt": { "type": "string" },
    "registries": { "type": "integer", "minimum": 0 },
    "rules": { "type": "integer", "minimum": 0 },
    "sources": { "type": "integer", "minimum": 0 },
    "ok": { "type": "integer", "minimum": 0 },
    "stale": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["registry", "ruleId", "reviewedAt", "ageDays", "maxReviewAgeDays"],
        "additionalProperties": false,
        "properties": {
          "registry": { "type": "string" },
          "ruleId": { "type": "string" },
          "reviewedAt": { "type": "string" },
          "ageDays": { "type": "integer", "minimum": 0 },
          "maxReviewAgeDays": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "duePromotion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["registry", "ruleId", "deadline"],
        "additionalProperties": false,
        "properties": {
          "registry": { "type": "string" },
          "ruleId": { "type": "string" },
          "deadline": { "type": "string" }
        }
      }
    },
    "unreachable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "reason", "ruleIds"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "reason": { "type": "string" },
          "ruleIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "reasons", "recorded", "current", "ruleIds"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "reasons": {
            "type": "array",
            "items": {
              "enum": ["final-url", "title", "redirect", "version-missing"]
            }
          },
          "recorded": {
            "type": "object",
            "required": ["finalUrl", "checkedAt"],
            "properties": {
              "finalUrl": { "type": "string" },
              "title": { "type": ["string", "null"] },
              "checkedAt": { "type": "string" },
              "status": { "type": "string" },
              "archiveUrl": { "type": "string" }
            }
          },
          "current": {
            "type": "object",
            "required": ["finalUrl"],
            "properties": {
              "finalUrl": { "type": "string" },
              "title": { "type": ["string", "null"] }
            }
          },
          "ruleIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "status", "ruleIds"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "status": { "type": "integer" },
          "ruleIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "unrecorded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "ruleIds"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "ruleIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "date-missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "ruleIds", "deadline"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "ruleIds": { "type": "array", "items": { "type": "string" } },
          "deadline": { "type": "string" }
        }
      }
    },
    "date-changed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "ruleIds", "expected"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "ruleIds": { "type": "array", "items": { "type": "string" } },
          "expected": { "type": "string" },
          "actual": { "type": ["string", "null"] },
          "pointer": { "type": "string" }
        }
      }
    },
    "archived-only": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "archiveUrl", "reason", "ruleIds"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "archiveUrl": { "type": "string" },
          "reason": { "type": "string" },
          "ruleIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
